# Copy to .env.local for local development. Set the same names in Vercel for production.
# Never commit real values.

# Public URL of the app, no trailing slash. Printed QR stickers, texted links and Twilio
# webhook signatures all use it, so it must be the live domain (production uses www).
NEXT_PUBLIC_APP_URL=https://www.linecatch.app

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (Console → Account info). Each barber's LineCatch number is set on their account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The A2P-registered Messaging Service (Twilio → Messaging → Services, starts with MG). New barber
# numbers are added to it automatically so their texts count as registered.
TWILIO_MESSAGING_SERVICE_SID=
# "false" stops all outgoing texts (they're still logged).
TWILIO_ENABLED=true
# "true" logs texts instead of sending them. Never true in production.
SMS_DEV_MODE=false

# Stripe (Dashboard → Developers → API keys). Test keys only (sk_test_ / rk_test_) until
# Phase 5 of PLAN.md: src/lib/stripe.ts refuses anything else.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vercel cron requests send "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Comma-separated Supabase user ids allowed into Admin: stickers (hand-out mode, printing).
ADMIN_USER_IDS=

# Shown in Settings, legal pages and the SMS HELP reply.
NEXT_PUBLIC_SUPPORT_EMAIL=support@linecatch.app
# Price of the optional mailed QR sticker add-on, in cents.
NEXT_PUBLIC_STICKER_PRICE_CENTS=700

# Local testing only. Never set in production.
# ALLOW_TIME_TRAVEL=true   # lets crons take ?now= to simulate future Wednesdays
# NEXT_PUBLIC_DEV_MODE=true
